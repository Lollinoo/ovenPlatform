# Backend Environment Variables Configuration
# This file defines environment variables for the Oven Platform backend.

# Frontend Configuration
FRONTEND_URL=        # URL of the frontend application

# Node.js Configuration
NODE_ENV=            # Environment mode (development, production, etc.)
NODE_PORT=           # Port on which the Node.js server will run

# OME (Oven Media Engine) Core Configuration
OME_PROTOCOL=        # Protocol for connecting to OME (http, https)
OME_HOST=            # Hostname or IP address of the OME server
OME_PORT=            # HTTP port for the OME API
OME_RTMP_PORT=       # RTMP port for streaming
OME_AUTH_USERNAME=   # Username for OME authentication
OME_AUTH_PASSWORD="" # Password for OME authentication
OME_VHOST_NAME=      # Virtual host name in OME
OME_APP_NAME=        # Application name in OME

# Security and Authentication
OME_API_SECRET_KEY=              # Secret key for OME API authentication
SIGNED_POLICY_SECRET_KEY=        # Secret key for signing policies
SIGNED_URL_EXPIRES_IN_SECONDS=   # Expiration time for signed URLs in seconds
OME_REQUEST_TIMEOUT=             # Timeout for OME API requests

# Thumbnail Configuration
OME_THUMBNAIL_PROTOCOL=  # Protocol for thumbnail service
OME_THUMBNAIL_HOST=      # Hostname or IP address of the thumbnail service
OME_THUMBNAIL_PORT=      # Port for the thumbnail service
