# OvenPlatform Backend Environment Configuration Example
# Copy this file to .env for production or .env.development for development

# Server Configuration
NODE_PORT=3000

# Frontend Configuration
FRONTEND_URL=http://localhost:4173
# Use the actual frontend URL where your frontend is hosted

# OvenMediaEngine (OME) Configuration
OME_PROTOCOL=http
OME_HOST=ome-server
OME_PORT=8081
OME_RTMP_PORT=1935

# OME Authentication
OME_AUTH_USERNAME=admin
OME_AUTH_PASSWORD=admin

# Stream Configuration
STREAM_KEY_SECRET=your-random-stream-key-secret
# Use a strong random string for production

# JWT Authentication
JWT_SECRET=your-random-jwt-secret
JWT_EXPIRES_IN=1d
# Use a strong random string for production

# CORS Configuration
CORS_ORIGINS=http://localhost:4173,https://your-domain.com
# Comma-separated list of allowed origins
