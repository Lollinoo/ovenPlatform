# OvenPlatform Frontend Environment Configuration Example
# Copy this file to .env for production or .env.development for development

# Application name
VITE_APP_NAME=OvenPlatform

# WebRTC Configuration
VITE_WEBRTC_URL_BASE=wss://your-domain.com/app
# Use ws:// for development and wss:// for production

# Low-Latency HLS Configuration
VITE_LLHLS_URL_BASE=https://your-domain.com/app
# Use http:// for development and https:// for production

# TURN Server Configuration
VITE_TURN_SERVER_URL_UDP=turn:your-turn-server.com:3478
VITE_TURN_SERVER_URL_TCP=turn:your-turn-server.com:3478?transport=tcp
VITE_TURN_SERVER_USERNAME=your-username
VITE_TURN_SERVER_CREDENTIAL=your-password

# API Configuration
VITE_API_URL=https://api.your-domain.com
# Use http://localhost:3000 for local development
