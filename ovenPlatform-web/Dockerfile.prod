# Dockerfile per produzione Vite + React

# Fase di build
FROM node:22.15.0-alpine3.20 AS builder
WORKDIR /app
COPY package.json package-lock.json* ./
ENV NODE_ENV=production
RUN npm install
COPY . .
RUN npm run build

# Fase di produzione
FROM node:22.15.0-alpine3.20
WORKDIR /app
COPY --from=builder /app/dist /app/dist

# Copia anche i file di configurazione e documentazione
COPY --from=builder /app/.env* /app/
COPY --from=builder /app/ENV_README.md /app/

# Installa serve per servire i file statici
RUN npm install -g serve

EXPOSE 4173

# Comando per avviare il server e servire la build di produzione
CMD ["serve", "-s", "dist", "-l", "4173"]