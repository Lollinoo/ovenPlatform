# Dockerfile per produzione Vite + React

# Fase di build
FROM node:22.15.0-alpine3.20 AS builder
WORKDIR /app

# Copia package.json e package-lock.json
COPY package.json package-lock.json* ./
ENV NODE_ENV=production

# Installa le dipendenze
RUN npm install

# Copia il resto dei file
COPY . .

# Compila l'applicazione
RUN npm run build

# Fase di produzione
FROM node:22.15.0-alpine3.20
WORKDIR /app

# Installa serve globalmente per servire i file statici
RUN npm install -g serve

# Copia i file di build dal builder
COPY --from=builder /app/dist /app/dist

# Copia anche i file di configurazione
COPY --from=builder /app/.env* /app/

EXPOSE 4173

# Comando per avviare il server e servire la build di produzione
CMD ["serve", "-s", "dist", "-l", "4173"]